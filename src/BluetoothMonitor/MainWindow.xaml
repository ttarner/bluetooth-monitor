<Window x:Class="BluetoothMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:BluetoothMonitor.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bluetooth Battery Monitor"
        Width="900"
        Height="680"
        MinWidth="900"
        MinHeight="680"
        Icon="/Assets/AppIconSource.png"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="White"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

        <shell:WindowChrome.WindowChrome>
                <shell:WindowChrome CaptionHeight="48"
                                    CornerRadius="8"
                                    GlassFrameThickness="0"
                                    ResizeBorderThickness="8"
                                    UseAeroCaptionButtons="False"/>
        </shell:WindowChrome.WindowChrome>

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

                <LinearGradientBrush x:Key="WindowBackgroundBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#08101C"
                                      Offset="0"/>
                        <GradientStop Color="#0B1422"
                                      Offset="0.55"/>
                        <GradientStop Color="#101723"
                                      Offset="1"/>
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="PanelBackgroundBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#172131"
                                      Offset="0"/>
                        <GradientStop Color="#111A28"
                                      Offset="1"/>
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="TitleBarBackgroundBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,0">
                        <GradientStop Color="#0E1825"
                                      Offset="0"/>
                        <GradientStop Color="#132234"
                                      Offset="0.5"/>
                        <GradientStop Color="#101A28"
                                      Offset="1"/>
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="CardBackgroundBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#162131"
                                      Offset="0"/>
                        <GradientStop Color="#101925"
                                      Offset="1"/>
                </LinearGradientBrush>

                <DropShadowEffect x:Key="SoftShadowEffect"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Color="#B0000000"
                                  Opacity="0.22"/>

                <DropShadowEffect x:Key="AccentGlowEffect"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Color="#3FCFEE"
                                  Opacity="0.16"/>

                <Style x:Key="TitleBarButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="31"/>
                        <Setter Property="Height"
                                Value="23"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Foreground"
                                Value="#E9EEF5"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                                Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="9"
                                                        Margin="3,0,0,0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#242424"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#2E2E2E"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="CloseTitleBarButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource TitleBarButtonStyle}">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="#B83A4A"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="SidebarButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="44"/>
                        <Setter Property="Height"
                                Value="44"/>
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Foreground"
                                Value="#C8D2DF"/>
                        <Setter Property="Background"
                                Value="#0F1B2A"/>
                        <Setter Property="BorderBrush"
                                Value="#26384B"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="FontFamily"
                                Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize"
                                Value="18"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Grid Width="{TemplateBinding Width}"
                                                      Height="{TemplateBinding Height}"
                                                      SnapsToDevicePixels="True">
                                                        <Border x:Name="ButtonBorder"
                                                                Margin="2"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="13">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#112338"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#2D5675"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#16304A"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="SidebarSelectedButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource SidebarButtonStyle}">
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="#103A4D"/>
                        <Setter Property="BorderBrush"
                                Value="#3FCFEE"/>
                        <Setter Property="BorderThickness"
                                Value="1.5"/>
                </Style>

                <Style x:Key="PillButtonStyle"
                       TargetType="Button">
                        <Setter Property="Padding"
                                Value="13,8"/>
                        <Setter Property="Foreground"
                                Value="#E7F2FF"/>
                        <Setter Property="Background"
                                Value="#182435"/>
                        <Setter Property="BorderBrush"
                                Value="#26384B"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#1D2C3F"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#385675"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#223349"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="AccentButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource PillButtonStyle}">
                        <Setter Property="Background"
                                Value="#114257"/>
                        <Setter Property="BorderBrush"
                                Value="#25C9E6"/>
                        <Setter Property="Effect"
                                Value="{StaticResource AccentGlowEffect}"/>
                </Style>

                <Style x:Key="SegmentRadioStyle"
                       TargetType="RadioButton">
                        <Setter Property="Foreground"
                                Value="#C6D3E3"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderBrush"
                                Value="#26384B"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="10,7"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="0,0,6,6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#18293B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#12465D"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#33CDEB"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="OverlayPositionIconViewboxStyle"
                       TargetType="Viewbox">
                        <Setter Property="Width"
                                Value="14"/>
                        <Setter Property="Height"
                                Value="14"/>
                        <Setter Property="Margin"
                                Value="0,0,8,0"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>

                <Style x:Key="OverlayPositionLabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </Style>

                <Style x:Key="OverlaySliderStyle"
                       TargetType="Slider">
                        <Setter Property="Height"
                                Value="24"/>
                        <Setter Property="Padding"
                                Value="12,0,12,0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                                <Grid Margin="{TemplateBinding Padding}"
                                                      ClipToBounds="False">
                                                        <Track x:Name="PART_Track"
                                                               ClipToBounds="False">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                                                      Background="#32CDEB"
                                                                                      Height="4"
                                                                                      Focusable="False">
                                                                                <RepeatButton.Template>
                                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="3"
                                                                                                        Height="4"
                                                                                                        VerticalAlignment="Center"/>
                                                                                        </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                </Track.DecreaseRepeatButton>

                                                                <Track.Thumb>
                                                                        <Thumb Width="18"
                                                                               Height="18"
                                                                               Background="#EAF7FF"
                                                                               BorderBrush="#D7EEF9"
                                                                               BorderThickness="1">
                                                                                <Thumb.Template>
                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                                <Ellipse Fill="#EAF7FF"
                                                                                                         Stroke="#C2E6F3"
                                                                                                         StrokeThickness="1"/>
                                                                                        </ControlTemplate>
                                                                                </Thumb.Template>
                                                                        </Thumb>
                                                                </Track.Thumb>

                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                                                      Background="#273246"
                                                                                      Height="4"
                                                                                      Focusable="False">
                                                                                <RepeatButton.Template>
                                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="3"
                                                                                                        Height="4"
                                                                                                        VerticalAlignment="Center"/>
                                                                                        </ControlTemplate>
                                                                                </RepeatButton.Template>
                                                                        </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                        </Track>
                                                </Grid>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="BatteryProgressBarStyle"
                       TargetType="ProgressBar">
                        <Setter Property="Height"
                                Value="10"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="#273246"
                                                        CornerRadius="5"
                                                        Height="{TemplateBinding Height}">
                                                        <Grid x:Name="PART_Track"
                                                              ClipToBounds="True">
                                                                <Border x:Name="PART_Indicator"
                                                                        Background="{TemplateBinding Foreground}"
                                                                        HorizontalAlignment="Left"
                                                                        CornerRadius="5"/>
                                                        </Grid>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="PreferenceCheckBoxStyle"
                       TargetType="CheckBox">
                        <Setter Property="Foreground"
                                Value="#EAF2FF"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border x:Name="Box"
                                                                Width="22"
                                                                Height="22"
                                                                CornerRadius="6"
                                                                Background="#152132"
                                                                BorderBrush="#2A3A4D"
                                                                BorderThickness="1">
                                                                <TextBlock x:Name="CheckGlyph"
                                                                           Text="✓"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="Transparent"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                        </Border>

                                                        <ContentPresenter Grid.Column="1"
                                                                          Margin="9,0,0,0"
                                                                          VerticalAlignment="Center"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked"
                                                                 Value="True">
                                                                <Setter TargetName="Box"
                                                                        Property="Background"
                                                                        Value="#17BFE2"/>
                                                                <Setter TargetName="Box"
                                                                        Property="BorderBrush"
                                                                        Value="#4ADAF2"/>
                                                                <Setter TargetName="CheckGlyph"
                                                                        Property="Foreground"
                                                                        Value="#06111C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Box"
                                                                        Property="BorderBrush"
                                                                        Value="#34CBE8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="SettingsCardStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="{StaticResource PanelBackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="#223245"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="18"/>
                        <Setter Property="Padding"
                                Value="20"/>
                        <Setter Property="Effect"
                                Value="{StaticResource SoftShadowEffect}"/>
                </Style>

                <Style x:Key="SettingsSectionTitleStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="FontSize"
                                Value="17"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                </Style>

                <Style x:Key="SettingsDescriptionStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="#8EA0B6"/>
                        <Setter Property="FontSize"
                                Value="12.5"/>
                        <Setter Property="TextWrapping"
                                Value="Wrap"/>
                </Style>

                <Style x:Key="SettingsComboBoxItemStyle"
                       TargetType="ComboBoxItem">
                        <Setter Property="Foreground"
                                Value="#DCE7F5"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Padding"
                                Value="10,7"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="2,1">
                                                        <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted"
                                                                 Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background"
                                                                        Value="#1A3042"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background"
                                                                        Value="#114257"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#6EE7D8"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="SettingsComboBoxStyle"
                       TargetType="ComboBox">
                        <Setter Property="Foreground"
                                Value="#EAF2FF"/>
                        <Setter Property="Background"
                                Value="#101A27"/>
                        <Setter Property="BorderBrush"
                                Value="#304458"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="10,6"/>
                        <Setter Property="ItemContainerStyle"
                                Value="{StaticResource SettingsComboBoxItemStyle}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                        <Border x:Name="FieldBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"/>
                                                        <ToggleButton Focusable="False"
                                                                      ClickMode="Press"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          VerticalAlignment="Center"
                                                                          IsHitTestVisible="False"
                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                                        <Path Width="8"
                                                              Height="5"
                                                              Margin="0,0,10,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Fill="#8FA5BA"
                                                              Stretch="Fill"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              IsHitTestVisible="False"/>
                                                        <Popup x:Name="Popup"
                                                               Placement="Bottom"
                                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               AllowsTransparency="True"
                                                               Focusable="False"
                                                               PopupAnimation="Fade">
                                                                <Border Margin="0,4,0,0"
                                                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        Background="#101A27"
                                                                        BorderBrush="#304458"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="3">
                                                                        <ScrollViewer MaxHeight="240"
                                                                                      CanContentScroll="True">
                                                                                <StackPanel IsItemsHost="True"/>
                                                                        </ScrollViewer>
                                                                </Border>
                                                        </Popup>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="FieldBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#3ACFEB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin"
                                                                 Value="True">
                                                                <Setter TargetName="FieldBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Shared input fallbacks keep every standard settings control on-brand,
                     including controls added later without an explicit style. -->
                <Style x:Key="SettingsTextBoxStyle"
                       TargetType="TextBox">
                        <Setter Property="Foreground"
                                Value="#EAF2FF"/>
                        <Setter Property="Background"
                                Value="#101A27"/>
                        <Setter Property="BorderBrush"
                                Value="#304458"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="9,0"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="CaretBrush"
                                Value="#6EE7D8"/>
                        <Setter Property="SelectionBrush"
                                Value="#176179"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="FieldBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="FieldBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#3ACFEB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused"
                                                                 Value="True">
                                                                <Setter TargetName="FieldBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsReadOnly"
                                                                 Value="True">
                                                                <Setter Property="Opacity"
                                                                        Value="0.72"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="AppScrollBarThumbStyle"
                       TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle"
                                Value="True"/>
                        <Setter Property="IsTabStop"
                                Value="False"/>
                        <Setter Property="Background"
                                Value="#2B4359"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ThumbBorder"
                                                                        Property="Background"
                                                                        Value="#3ACFEB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging"
                                                                 Value="True">
                                                                <Setter TargetName="ThumbBorder"
                                                                        Property="Background"
                                                                        Value="#6EE7D8"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="AppScrollBarPageButtonStyle"
                       TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle"
                                Value="True"/>
                        <Setter Property="Focusable"
                                Value="False"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"/>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <ControlTemplate x:Key="VerticalScrollBarTemplate"
                                 TargetType="ScrollBar">
                        <Grid Width="12"
                              Background="Transparent"
                              SnapsToDevicePixels="True">
                                <Border x:Name="TrackBackground"
                                        Margin="2,0"
                                        Background="#0F1825"
                                        BorderBrush="#203042"
                                        BorderThickness="1"
                                        CornerRadius="6"/>
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Style="{StaticResource AppScrollBarPageButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                                <Thumb Style="{StaticResource AppScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Style="{StaticResource AppScrollBarPageButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter TargetName="TrackBackground"
                                                Property="BorderBrush"
                                                Value="#304458"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.45"/>
                                </Trigger>
                        </ControlTemplate.Triggers>
                </ControlTemplate>

                <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                                 TargetType="ScrollBar">
                        <Grid Height="12"
                              Background="Transparent"
                              SnapsToDevicePixels="True">
                                <Border x:Name="TrackBackground"
                                        Margin="0,2"
                                        Background="#0F1825"
                                        BorderBrush="#203042"
                                        BorderThickness="1"
                                        CornerRadius="6"/>
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                              Style="{StaticResource AppScrollBarPageButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                                <Thumb Style="{StaticResource AppScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                                              Style="{StaticResource AppScrollBarPageButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter TargetName="TrackBackground"
                                                Property="BorderBrush"
                                                Value="#304458"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.45"/>
                                </Trigger>
                        </ControlTemplate.Triggers>
                </ControlTemplate>

                <Style x:Key="AppScrollBarStyle"
                       TargetType="ScrollBar">
                        <Setter Property="Width"
                                Value="12"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Template"
                                Value="{StaticResource VerticalScrollBarTemplate}"/>
                        <Style.Triggers>
                                <Trigger Property="Orientation"
                                         Value="Horizontal">
                                        <Setter Property="Height"
                                                Value="12"/>
                                        <Setter Property="Width"
                                                Value="Auto"/>
                                        <Setter Property="Template"
                                                Value="{StaticResource HorizontalScrollBarTemplate}"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="AppScrollViewerStyle"
                       TargetType="ScrollViewer">
                        <Setter Property="Background"
                                Value="Transparent"/>
                </Style>

                <Style TargetType="TextBox"
                       BasedOn="{StaticResource SettingsTextBoxStyle}"/>
                <Style TargetType="ComboBox"
                       BasedOn="{StaticResource SettingsComboBoxStyle}"/>
                <Style TargetType="ComboBoxItem"
                       BasedOn="{StaticResource SettingsComboBoxItemStyle}"/>
                <Style TargetType="ScrollBar"
                       BasedOn="{StaticResource AppScrollBarStyle}"/>
                <Style TargetType="ScrollViewer"
                       BasedOn="{StaticResource AppScrollViewerStyle}"/>

                <Style x:Key="SettingsRowContainerStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="#141F2D"/>
                        <Setter Property="BorderBrush"
                                Value="#203042"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="12"/>
                        <Setter Property="Padding"
                                Value="14,12"/>
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                </Style>

                <Style x:Key="SettingsToggleCheckBoxStyle"
                       TargetType="CheckBox">
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                                <Grid Width="48"
                                                      Height="28">
                                                        <Border x:Name="Track"
                                                                Background="#243244"
                                                                BorderBrush="#304458"
                                                                BorderThickness="1"
                                                                CornerRadius="14"/>
                                                        <Ellipse x:Name="Thumb"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Margin="3,0,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 Fill="#DCEAF5"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked"
                                                                 Value="True">
                                                                <Setter TargetName="Track"
                                                                        Property="Background"
                                                                        Value="#114257"/>
                                                                <Setter TargetName="Track"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                                <Setter TargetName="Thumb"
                                                                        Property="HorizontalAlignment"
                                                                        Value="Right"/>
                                                                <Setter TargetName="Thumb"
                                                                        Property="Margin"
                                                                        Value="0,0,3,0"/>
                                                                <Setter TargetName="Thumb"
                                                                        Property="Fill"
                                                                        Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Track"
                                                                        Property="BorderBrush"
                                                                        Value="#3ACFEB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="WidgetChipCheckBoxStyle"
                       TargetType="CheckBox">
                        <Setter Property="Foreground"
                                Value="#DCE7F5"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Margin"
                                Value="0,0,10,10"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="Chip"
                                                        Background="#141F2D"
                                                        BorderBrush="#223245"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12,8">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="Box"
                                                                        Width="18"
                                                                        Height="18"
                                                                        CornerRadius="5"
                                                                        Background="#1D2A3A"
                                                                        BorderBrush="#33465B"
                                                                        BorderThickness="1">
                                                                        <TextBlock x:Name="Glyph"
                                                                                   Text="✓"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="Transparent"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ContentPresenter Grid.Column="1"
                                                                                  Margin="9,0,0,0"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked"
                                                                 Value="True">
                                                                <Setter TargetName="Chip"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                                <Setter TargetName="Chip"
                                                                        Property="Background"
                                                                        Value="#112A3A"/>
                                                                <Setter TargetName="Box"
                                                                        Property="Background"
                                                                        Value="#17BFE2"/>
                                                                <Setter TargetName="Box"
                                                                        Property="BorderBrush"
                                                                        Value="#4ADAF2"/>
                                                                <Setter TargetName="Glyph"
                                                                        Property="Foreground"
                                                                        Value="#06111C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Chip"
                                                                        Property="BorderBrush"
                                                                        Value="#3ACFEB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="ActionButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="40"/>
                        <Setter Property="Height"
                                Value="40"/>
                        <Setter Property="Background"
                                Value="#152233"/>
                        <Setter Property="Foreground"
                                Value="#E7F2FF"/>
                        <Setter Property="BorderBrush"
                                Value="#2A3D52"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="20"/>
                        <Setter Property="Padding"
                                Value="0,-4,0,0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#39CBE8"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#1A2B3E"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#20344A"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="WidgetOrderMoveButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource PillButtonStyle}">
                        <Setter Property="Width"
                                Value="34"/>
                        <Setter Property="Height"
                                Value="34"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                </Style>

                <Style x:Key="WidgetOrderListBoxStyle"
                       TargetType="ListBox">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                </Style>

                <Style x:Key="WidgetOrderListBoxItemStyle"
                       TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="0,0,0,8"/>
                        <Setter Property="Cursor"
                                Value="SizeAll"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="#101A27"
                                                        BorderBrush="#304458"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12,10">
                                                        <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#3ACFEB"/>
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background"
                                                                        Value="#122133"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin"
                                                                 Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#2FD0EC"/>
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background"
                                                                        Value="#122638"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>

        <Border x:Name="WindowFrame"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="#1C2838"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                SnapsToDevicePixels="True">

                <Grid x:Name="WindowContentRoot"
                      ClipToBounds="True">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,1"
                                Padding="0"
                                Background="{StaticResource TitleBarBackgroundBrush}"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0">
                                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                                      Margin="6,0,6,0">

                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                                <Border Width="25"
                                                        Height="25"
                                                        CornerRadius="6"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Margin="0,0,6,0">
                                                        <Image Source="/Assets/AppIconSource.png"
                                                               Width="21"
                                                               Height="21"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="Bluetooth Battery Monitor"
                                                           FontSize="12.5"
                                                           FontWeight="Normal"
                                                           Foreground="#F4F6F8"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                                        Content="−"
                                                        Click="MinimizeButton_Click"/>
                                                <Button x:Name="MaximizeRestoreButton"
                                                        Style="{StaticResource TitleBarButtonStyle}"
                                                        Content="❐"
                                                        Click="MaximizeRestoreButton_Click"/>
                                                <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                                                        Content="✕"
                                                        Click="CloseButton_Click"/>
                                        </StackPanel>
                                </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="72"
                                        Margin="10,8,10,14"
                                        HorizontalAlignment="Center"
                                        Background="#0D1724"
                                        BorderBrush="#1B2737"
                                        BorderThickness="1"
                                        CornerRadius="14">

                                        <Grid Margin="12,14,12,14">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Button x:Name="DashboardSidebarButton"
                                                        Grid.Row="0"
                                                        Style="{StaticResource SidebarSelectedButtonStyle}"
                                                        Content="&#xE71D;"
                                                        Click="SidebarDashboardButton_Click"
                                                        ToolTip="Dashboard"/>

                                                <Button x:Name="SettingsSidebarButton"
                                                        Grid.Row="2"
                                                        Style="{StaticResource SidebarButtonStyle}"
                                                        Content="&#xE713;"
                                                        Click="SidebarSettingsButton_Click"
                                                        ToolTip="Settings"/>

                                                <Button x:Name="AboutSidebarButton"
                                                        Grid.Row="3"
                                                        Style="{StaticResource SidebarButtonStyle}"
                                                        Margin="0"
                                                        Content="&#xE946;"
                                                        Click="SidebarInfoButton_Click"
                                                        ToolTip="About"/>
                                        </Grid>
                                </Border>

                                <Grid Grid.Column="1"
                                      Margin="8,8,16,14">
                                        <Grid x:Name="DashboardView">
                                                <ScrollViewer x:Name="MainScrollViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,14,0">
                                                        <StackPanel HorizontalAlignment="Stretch">
                                                                <StackPanel MaxWidth="640"
                                                                            Margin="0,8,0,16"
                                                                            HorizontalAlignment="Left">

                                                                        <TextBlock Text="Dashboard"
                                                                                   FontSize="40"
                                                                                   FontWeight="SemiBold"
                                                                                   LineHeight="44"
                                                                                   TextWrapping="Wrap"/>

                                                                        <TextBlock Text="Battery levels reported by connected Windows devices"
                                                                                   Foreground="#91A0B3"
                                                                                   FontSize="14"
                                                                                   Margin="0,8,0,0"
                                                                                   TextWrapping="Wrap"/>

                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Margin="0,20,0,0">

                                                                                <Border Padding="14,9"
                                                                                        Background="#151F2D"
                                                                                        BorderBrush="#233446"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="13">

                                                                                        <StackPanel Orientation="Horizontal">
                                                                                                <Ellipse Width="9"
                                                                                                         Height="9"
                                                                                                         Fill="#62DB7B"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Margin="0,0,10,0"/>

                                                                                                <TextBlock x:Name="StatusText"
                                                                                                           Text="Looking for connected devices…"
                                                                                                           Foreground="#C9D4E4"
                                                                                                           FontSize="13"
                                                                                                           VerticalAlignment="Center"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                        </StackPanel>
                                                                                </Border>

                                                                                <Button Content="Refresh"
                                                                                        Click="RefreshButton_Click"
                                                                                        Style="{StaticResource PillButtonStyle}"
                                                                                        Margin="10,0,0,0"/>
                                                                        </StackPanel>
                                                                </StackPanel>

                                                                <Grid Margin="0,10,0,0"
                                                                      HorizontalAlignment="Stretch">
                                                                        <ItemsControl ItemsSource="{Binding Devices}"
                                                                                      HorizontalAlignment="Stretch">
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Border Background="{StaticResource CardBackgroundBrush}"
                                                                                                        BorderBrush="{Binding BatteryColor}"
                                                                                                        BorderThickness="1"
                                                                                                        CornerRadius="14"
                                                                                                        Padding="10"
                                                                                                        Margin="0,0,0,8"
                                                                                                        Effect="{StaticResource SoftShadowEffect}">

                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                        <ColumnDefinition Width="*"
                                                                                                                                          MinWidth="96"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                        <ColumnDefinition Width="*"
                                                                                                                                          MinWidth="72"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                </Grid.ColumnDefinitions>

                                                                                                                <Border Width="40"
                                                                                                                        Height="40"
                                                                                                                        Background="{Binding CategoryBadgeColor}"
                                                                                                                        CornerRadius="11"
                                                                                                                        VerticalAlignment="Center">
                                                                                                                        <TextBlock Text="{Binding CategoryIcon}"
                                                                                                                                   Foreground="White"
                                                                                                                                   FontSize="17"
                                                                                                                                   FontFamily="Segoe UI Emoji"
                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                   HorizontalAlignment="Center"
                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                </Border>

                                                                                                                <StackPanel Grid.Column="1"
                                                                                                                            Margin="10,0,10,0"
                                                                                                                            VerticalAlignment="Center">

                                                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                                                   FontSize="15"
                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                                                                        <StackPanel Orientation="Horizontal"
                                                                                                                                    Margin="0,2,0,0">
                                                                                                                                <Ellipse Width="6"
                                                                                                                                         Height="6"
                                                                                                                                         Fill="#62DB7B"
                                                                                                                                         VerticalAlignment="Center"
                                                                                                                                         Margin="0,0,5,0"/>

                                                                                                                                <TextBlock Text="{Binding StatusText}"
                                                                                                                                           Foreground="#B5C4D7"
                                                                                                                                           FontSize="11"
                                                                                                                                           VerticalAlignment="Center"
                                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                                                <TextBlock Text="{Binding AliasText}"
                                                                                                                                           Foreground="#7E8C9F"
                                                                                                                                           FontSize="11"
                                                                                                                                           Margin="8,0,0,0"
                                                                                                                                           VerticalAlignment="Center"
                                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                                        </StackPanel>
                                                                                                                </StackPanel>

                                                                                                                <StackPanel Grid.Column="2"
                                                                                                                            Orientation="Horizontal"
                                                                                                                            VerticalAlignment="Center"
                                                                                                                            Margin="0,0,8,0">

                                                                                                                        <Grid Width="36"
                                                                                                                              Height="36"
                                                                                                                              Margin="0,0,8,0">
                                                                                                                                <Ellipse Stroke="#253446"
                                                                                                                                         StrokeThickness="3.5"/>
                                                                                                                                <Ellipse Stroke="{Binding BatteryColor}"
                                                                                                                                         StrokeThickness="3.5"
                                                                                                                                         Opacity="0.95"/>
                                                                                                                                <TextBlock Text="🔋"
                                                                                                                                           FontSize="13"
                                                                                                                                           HorizontalAlignment="Center"
                                                                                                                                           VerticalAlignment="Center"/>
                                                                                                                        </Grid>

                                                                                                                        <StackPanel Orientation="Horizontal"
                                                                                                                                    VerticalAlignment="Center"
                                                                                                                                    MinWidth="52">
                                                                                                                                <TextBlock Text="{Binding BatteryText}"
                                                                                                                                           FontSize="20"
                                                                                                                                           FontWeight="SemiBold"
                                                                                                                                           VerticalAlignment="Center"/>
                                                                                                                                <TextBlock Text="⚡"
                                                                                                                                           FontFamily="Segoe UI Emoji"
                                                                                                                                           FontSize="13"
                                                                                                                                           Foreground="#6EE7D8"
                                                                                                                                           Margin="3,0,0,0"
                                                                                                                                           VerticalAlignment="Center"
                                                                                                                                           ToolTip="Charging"
                                                                                                                                           Visibility="{Binding IsCharging, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                                                        </StackPanel>
                                                                                                                </StackPanel>

                                                                                                                <ProgressBar Grid.Column="3"
                                                                                                                             Margin="0,0,10,0"
                                                                                                                             VerticalAlignment="Center"
                                                                                                                             Minimum="0"
                                                                                                                             Maximum="100"
                                                                                                                             Value="{Binding BatteryWidth, Mode=OneWay}"
                                                                                                                             Foreground="{Binding BatteryColor}"
                                                                                                                             behaviors:BatteryBarAttentionBehavior.AttentionSequence="{Binding LowBatteryAttentionSequence}"
                                                                                                                             Style="{StaticResource BatteryProgressBarStyle}"/>

                                                                                                                <Button Grid.Column="4"
                                                                                                                        Margin="0,0,8,0"
                                                                                                                        Style="{StaticResource ActionButtonStyle}"
                                                                                                                        Background="{Binding AliasButtonBackground}"
                                                                                                                        Foreground="{Binding AliasButtonForeground}"
                                                                                                                        ToolTip="{Binding AliasTooltip}"
                                                                                                                        FontFamily="Segoe UI Emoji"
                                                                                                                        FontSize="13"
                                                                                                                        Content="✎"
                                                                                                                        Click="AliasButton_Click"/>
                                                                                                                <Button Grid.Column="5"
                                                                                                                        Style="{StaticResource ActionButtonStyle}"
                                                                                                                        Background="{Binding OverlayVisibilityButtonBackground}"
                                                                                                                        Foreground="{Binding OverlayVisibilityButtonForeground}"
                                                                                                                        ToolTip="{Binding OverlayVisibilityTooltip}"
                                                                                                                        FontFamily="Segoe UI Emoji"
                                                                                                                        FontSize="14"
                                                                                                                        Content="{Binding OverlayVisibilityIcon}"
                                                                                                                        Click="OverlayVisibilityButton_Click"/>
                                                                                                        </Grid>
                                                                                                </Border>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <StackPanel x:Name="EmptyState"
                                                                                    VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Center"
                                                                                    Visibility="Collapsed"
                                                                                    Margin="0,24,0,24">

                                                                                <TextBlock Text="No supported connected devices found"
                                                                                           FontSize="18"
                                                                                           HorizontalAlignment="Center"/>

