                                                                                                                 Drop="OverlayWidgetOrderListBox_Drop">
                                                                                                                <ListBox.ItemTemplate>
                                                                                                                        <DataTemplate>
                                                                                                                                <Grid>
                                                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                                                <ColumnDefinition Width="26"/>
                                                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                                        </Grid.ColumnDefinitions>
                                                                                                                                        <TextBlock Text="⋮⋮"
                                                                                                                                                   Foreground="#6EE7D8"
                                                                                                                                                   FontSize="12"
                                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                                        <TextBlock Grid.Column="1"
                                                                                                                                                   Text="{Binding Index}"
                                                                                                                                                   Foreground="#6EE7D8"
                                                                                                                                                   FontSize="13"
                                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                                   Margin="0,0,10,0"
                                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                                        <TextBlock Grid.Column="2"
                                                                                                                                                   Text="{Binding Label}"
                                                                                                                                                   Foreground="#EAF2FF"
                                                                                                                                                   FontSize="13"
                                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                                        <TextBlock Grid.Column="3"
                                                                                                                                                   Text="Drag"
                                                                                                                                                   Foreground="#8FA5BA"
                                                                                                                                                   FontSize="11"
                                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                                </Grid>
                                                                                                                        </DataTemplate>
                                                                                                                </ListBox.ItemTemplate>
                                                                                                        </ListBox>
                                                                                                </StackPanel>
                                                                                        </Border>

                                                                                        <Border Style="{StaticResource SettingsRowContainerStyle}">
                                                                                                <Grid VerticalAlignment="Center">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Text="Scale"
                                                                                                                   Foreground="#EAF2FF"
                                                                                                                   FontSize="13.5"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Margin="0,0,18,0"/>
                                                                                                        <Slider x:Name="OverlayScaleSlider"
                                                                                                                Grid.Column="1"
                                                                                                                Minimum="50"
                                                                                                                Maximum="200"
                                                                                                                TickFrequency="10"
                                                                                                                Style="{StaticResource OverlaySliderStyle}"
                                                                                                                IsSnapToTickEnabled="False"
                                                                                                                ValueChanged="OverlayScaleSlider_ValueChanged"/>
                                                                                                        <TextBlock x:Name="OverlayScaleValueText"
                                                                                                                   Grid.Column="2"
                                                                                                                   Foreground="White"
                                                                                                                   FontSize="13"
                                                                                                                   Margin="10,0,0,0"
                                                                                                                   HorizontalAlignment="Right"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                </Grid>
                                                                                        </Border>

                                                                                        <Border Style="{StaticResource SettingsRowContainerStyle}">
                                                                                                <Grid VerticalAlignment="Center">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Text="Background"
                                                                                                                   Foreground="#EAF2FF"
                                                                                                                   FontSize="13.5"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Margin="0,0,18,0"/>
                                                                                                        <Slider x:Name="OverlayBackgroundOpacitySlider"
                                                                                                                Grid.Column="1"
                                                                                                                Minimum="0"
                                                                                                                Maximum="100"
                                                                                                                TickFrequency="5"
                                                                                                                Style="{StaticResource OverlaySliderStyle}"
                                                                                                                IsSnapToTickEnabled="False"
                                                                                                                ValueChanged="OverlayBackgroundOpacitySlider_ValueChanged"/>
                                                                                                        <TextBlock x:Name="OverlayBackgroundOpacityValueText"
                                                                                                                   Grid.Column="2"
                                                                                                                   Foreground="White"
                                                                                                                   FontSize="13"
                                                                                                                   Margin="10,0,0,0"
                                                                                                                   HorizontalAlignment="Right"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                </Grid>
                                                                                        </Border>

                                                                                        <Border Style="{StaticResource SettingsRowContainerStyle}"
                                                                                                Margin="0,0,0,16">
                                                                                                <Grid VerticalAlignment="Center">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Text="Text opacity"
                                                                                                                   Foreground="#EAF2FF"
                                                                                                                   FontSize="13.5"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Margin="0,0,18,0"/>
                                                                                                        <Slider x:Name="OverlayTextOpacitySlider"
                                                                                                                Grid.Column="1"
                                                                                                                Minimum="15"
                                                                                                                Maximum="100"
                                                                                                                TickFrequency="5"
                                                                                                                Style="{StaticResource OverlaySliderStyle}"
                                                                                                                IsSnapToTickEnabled="False"
                                                                                                                ValueChanged="OverlayTextOpacitySlider_ValueChanged"/>
                                                                                                        <TextBlock x:Name="OverlayTextOpacityValueText"
                                                                                                                   Grid.Column="2"
                                                                                                                   Foreground="White"
                                                                                                                   FontSize="13"
                                                                                                                   Margin="10,0,0,0"
                                                                                                                   HorizontalAlignment="Right"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                </Grid>
                                                                                        </Border>

                                                                                        <Border Style="{StaticResource SettingsRowContainerStyle}"
                                                                                                Margin="0,0,0,16">
                                                                                                <Grid VerticalAlignment="Center">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Text="Low battery"
                                                                                                                   Foreground="#EAF2FF"
                                                                                                                   FontSize="13.5"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Margin="0,0,18,0"/>
                                                                                                        <Slider x:Name="LowBatteryThresholdSlider"
                                                                                                                Grid.Column="1"
                                                                                                                Minimum="1"
                                                                                                                Maximum="50"
                                                                                                                TickFrequency="1"
                                                                                                                Style="{StaticResource OverlaySliderStyle}"
                                                                                                                IsSnapToTickEnabled="True"
                                                                                                                ValueChanged="LowBatteryThresholdSlider_ValueChanged"/>
                                                                                                        <TextBlock x:Name="LowBatteryThresholdValueText"
                                                                                                                   Grid.Column="2"
                                                                                                                   Foreground="White"
                                                                                                                   FontSize="13"
                                                                                                                   Margin="10,0,0,0"
                                                                                                                   HorizontalAlignment="Right"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                </Grid>
                                                                                        </Border>

                                                                                        <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                </Grid.ColumnDefinitions>

                                                                                                <Button Content="Reset"
                                                                                                        Height="40"
                                                                                                        Margin="0,0,8,0"
                                                                                                        Style="{StaticResource PillButtonStyle}"
                                                                                                        Click="ResetOverlaySettingsButton_Click"/>

                                                                                                <Button x:Name="OverlayButton"
                                                                                                        Grid.Column="1"
                                                                                                        Height="40"
                                                                                                        Margin="8,0,0,0"
                                                                                                        Content="Show overlay"
                                                                                                        Click="OverlayButton_Click"
                                                                                                        Style="{StaticResource AccentButtonStyle}"/>
                                                                                        </Grid>

                                                                                        <ComboBox x:Name="PositionCombo"
                                                                                                  Width="1"
                                                                                                  Height="1"
                                                                                                  Opacity="0"
                                                                                                  IsHitTestVisible="False"
                                                                                                  SelectedValuePath="Tag"
                                                                                                  SelectionChanged="PositionCombo_SelectionChanged">
                                                                                                <ComboBoxItem Content="Top left"
                                                                                                              Tag="TopLeft"/>
                                                                                                <ComboBoxItem Content="Top right"
                                                                                                              Tag="TopRight"/>
                                                                                                <ComboBoxItem Content="Center left"
                                                                                                              Tag="CenterLeft"/>
                                                                                                <ComboBoxItem Content="Center right"
                                                                                                              Tag="CenterRight"/>
                                                                                                <ComboBoxItem Content="Bottom left"
                                                                                                              Tag="BottomLeft"/>
                                                                                                <ComboBoxItem Content="Bottom right"
                                                                                                              Tag="BottomRight"/>
                                                                                        </ComboBox>
                                                                                </StackPanel>
                                                                        </Border>
                                                                </Grid>
                                                        </StackPanel>
                                                </ScrollViewer>
                                        </Grid>

                                        <Grid x:Name="AboutView"
                                              Visibility="Collapsed">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,14,0">
                                                        <StackPanel>
                                                                <StackPanel Margin="0,8,0,18">
                                                                        <TextBlock Text="About"
                                                                                   FontSize="34"
                                                                                   FontWeight="SemiBold"/>
                                                                        <TextBlock Text="Bluetooth Battery Monitor helps you keep an eye on battery levels, overlay behavior, and startup settings for supported wireless devices."
                                                                                   Foreground="#91A0B3"
                                                                                   FontSize="14"
                                                                                   Margin="0,8,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <Border Style="{StaticResource SettingsCardStyle}"
                                                                        Width="520"
                                                                        HorizontalAlignment="Left">
                                                                        <StackPanel>
                                                                                <TextBlock Text="Bluetooth Battery Monitor"
                                                                                           Style="{StaticResource SettingsSectionTitleStyle}"/>
                                                                                <TextBlock Text="A Windows desktop app built with WPF for monitoring Bluetooth battery levels with an optional always-on-top overlay and tray integration."
                                                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                                                           Margin="0,6,0,18"/>

                                                                                <Border Style="{StaticResource SettingsRowContainerStyle}">
                                                                                        <StackPanel>
                                                                                                <TextBlock Text="What it does"
                                                                                                           Foreground="#EAF2FF"
                                                                                                           FontSize="13.5"
                                                                                                           FontWeight="SemiBold"/>
                                                                                                <TextBlock Text="Shows battery levels for connected Bluetooth devices, supported PlayStation controllers, and SteelSeries Arctis 7+ headsets."
                                                                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                                                                           Margin="0,4,0,0"/>
                                                                                        </StackPanel>
                                                                                </Border>

                                                                                <Border Style="{StaticResource SettingsRowContainerStyle}">
                                                                                        <StackPanel>
                                                                                                <TextBlock Text="Overlay and tray features"
                                                                                                           Foreground="#EAF2FF"
                                                                                                           FontSize="13.5"
                                                                                                           FontWeight="SemiBold"/>
                                                                                                <TextBlock Text="Supports a click-through overlay for games and apps, per-device overlay visibility, startup options, system widgets, and background monitoring from the tray icon."
                                                                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                                                                           Margin="0,4,0,0"/>
                                                                                        </StackPanel>
                                                                                </Border>

                                                                                <Border Style="{StaticResource SettingsRowContainerStyle}"
                                                                                        Margin="0">
                                                                                        <StackPanel>
                                                                                                <TextBlock Text="Notes"
                                                                                                           Foreground="#EAF2FF"
                                                                                                           FontSize="13.5"
                                                                                                           FontWeight="SemiBold"/>
                                                                                                <TextBlock Text="True exclusive fullscreen games can still cover normal desktop overlays. Borderless fullscreen gives the most reliable results."
                                                                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                                                                           Margin="0,4,0,0"/>
                                                                                        </StackPanel>
                                                                                </Border>
                                                                        </StackPanel>
                                                                </Border>
                                                        </StackPanel>
                                                </ScrollViewer>
                                        </Grid>
                                </Grid>
                        </Grid>
                </Grid>
        </Border>
</Window>
