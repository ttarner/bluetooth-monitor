<Window x:Class="BluetoothMonitor.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="96"
        SizeToContent="WidthAndHeight"
        MaxHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Border x:Name="OverlayRoot"
          Background="#C8111318"
          CornerRadius="8"
          Padding="9,6"
          RenderTransformOrigin="0.5,0.5">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="OverlayScaleTransform"
                      ScaleX="1"
                      ScaleY="1"/>
    </Border.LayoutTransform>
    <StackPanel x:Name="OverlayWidgetsPanel"
                MinWidth="220">
      <Border x:Name="WeatherWidgetBackground"
              Background="#191F27"
              CornerRadius="6"
              Padding="9,7"
              Margin="0,0,0,7"
              Visibility="{Binding Weather.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid MinWidth="192">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding Weather.Icon}"
                     FontFamily="Segoe UI Emoji"
                     FontSize="25"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding Weather.HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Loading weather…"
                       Foreground="#A6E3DE"
                       FontSize="12"
                       Visibility="{Binding Weather.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <StackPanel Visibility="{Binding Weather.ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Weather.Location}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Weather.Temperature}"
                           Foreground="#A6E3DE"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="8,0,0,0"/>
              </Grid>
              <TextBlock Text="{Binding Weather.Condition}"
                         Foreground="#C7D3E0"
                         FontSize="11"
                         Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Weather.ErrorMessage}"
                         Foreground="#FF9A9A"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,3,0,0"
                         Visibility="{Binding Weather.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="SystemWidgetBackground"
              Background="#191F27"
              CornerRadius="6"
              Padding="9,7"
              Margin="0,0,0,7"
              Visibility="{Binding SystemWidget.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel x:Name="SystemWidgetContent">
          <TextBlock Text="{Binding SystemWidget.TimeText}"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Visibility="{Binding SystemWidget.ShowClock, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SystemWidget.CpuText}"
                       Foreground="#A6E3DE"
                       FontSize="12"
                       Margin="0,0,6,4"
                       TextAlignment="Left"
                       Visibility="{Binding SystemWidget.ShowCpu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SystemWidget.RamText}"
                       Foreground="#A6E3DE"
                       FontSize="12"
                       Margin="6,0,0,4"
                       TextAlignment="Right"
                       Visibility="{Binding SystemWidget.ShowRam, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SystemWidget.CpuTemperatureText}"
                       Foreground="#FFB86B"
                       FontSize="12"
                       Margin="0,0,6,4"
                       TextAlignment="Left"
                       Visibility="{Binding SystemWidget.ShowCpuTemperature, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SystemWidget.GpuTemperatureText}"
                       Foreground="#FFB86B"
                       FontSize="12"
                       Margin="6,0,0,4"
                       TextAlignment="Right"
                       Visibility="{Binding SystemWidget.ShowGpuTemperature, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
              <ColumnDefinition Width="*"
                                MinWidth="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SystemWidget.NetworkInText}"
                       Foreground="#89D2FF"
                       FontSize="12"
                       Margin="0,0,6,4"
                       TextAlignment="Left"
                       Visibility="{Binding SystemWidget.ShowNetworkIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SystemWidget.NetworkOutText}"
                       Foreground="#89D2FF"
                       FontSize="12"
                       Margin="6,0,0,4"
                       TextAlignment="Right"
                       Visibility="{Binding SystemWidget.ShowNetworkOut, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border x:Name="NowPlayingWidgetBackground"
              Width="220"
              Background="#191F27"
              CornerRadius="6"
              Padding="9,7"
              Margin="0,0,0,7"
              Visibility="{Binding NowPlaying.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Width="202">
          <TextBlock Text="NOW PLAYING"
                     Foreground="#6EE7D8"
                     FontSize="10"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding NowPlaying.Title}"
                     Foreground="White"
                     FontSize="13"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,2,0,0"/>
          <TextBlock Text="{Binding NowPlaying.RomajiTitle}"
                     Foreground="#9FB3C8"
                     FontSize="10"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding NowPlaying.HasRomajiTitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <TextBlock Text="{Binding NowPlaying.Artist}"
                     Foreground="#C7D3E0"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,1,0,0"/>
          <TextBlock Text="{Binding NowPlaying.MediaTag}"
                     Foreground="#FFB86B"
                     FontSize="10"
                     Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding NowPlaying.HasMediaTag, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
      </Border>
      <ItemsControl x:Name="DevicesItemsControl"
                    ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2,3"
                  Visibility="{Binding ShowInOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding DisplayName}"
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <TextBlock Text="⚡"
                           FontFamily="Segoe UI Emoji"
                           Foreground="#6EE7D8"
                           FontSize="12"
                           Margin="0,0,3,0"
                           ToolTip="Charging"
                           Visibility="{Binding IsCharging, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Grid Width="20"
                      Height="10"
                      Margin="0,0,0,0"
                      VerticalAlignment="Center">
                  <Border Width="17"
                          Height="10"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          BorderBrush="{Binding BatteryOutlineColor}"
                          BorderThickness="1"
                          CornerRadius="1">
                    <Grid Margin="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0"
                              Margin="0,0,1,0"
                              Background="{Binding BatterySegment1Color}"
                              CornerRadius="0.5"/>
                      <Border Grid.Column="1"
                              Margin="0,0,1,0"
                              Background="{Binding BatterySegment2Color}"
                              CornerRadius="0.5"/>
                      <Border Grid.Column="2"
                              Margin="0,0,1,0"
                              Background="{Binding BatterySegment3Color}"
                              CornerRadius="0.5"/>
                      <Border Grid.Column="3"
                              Background="{Binding BatterySegment4Color}"
                              CornerRadius="0.5"/>
                    </Grid>
                  </Border>
                  <Border Width="2"
                          Height="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Background="{Binding BatteryTipColor}"
                          CornerRadius="0.5"/>
                </Grid>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
